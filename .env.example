# ==============================================================================
# DDR-AI Application Environment Configuration
# ==============================================================================

# Google Gemini API key used for multi-stage building diagnostic analysis.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# System configuration overrides (Optional)
# If Tesseract OCR or Poppler is not in your system's PATH, uncomment and set below:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\Program Files\poppler\bin

# DeepSeek / NVIDIA API Key (Optional alternative provider)
# LLM_PROVIDER=DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_or_nvidia_api_key_here
